[
  {
    "kernelSource": {
      "name": "VantomKernel",
      "repo": "https://github.com/Lafactorial/kernel_xiaomi_sm6150",
      "branch": "lineage-22.1",
      "device": "sweet_k6a",
      "defconfig": "sweet_defconfig"
    },
    "toolchains":
      {
        "repo": "https://gitlab.com/itsshashanksp/android_prebuilts_clang_host_linux-x86_clang-r530567",
        "branch": "14.0",
        "name": "clang",
        "binaryEnv": [
          "bin"
        ]
      },
    "enableCcache": true,
    "params": {
      "ARCH": "arm64",
      "CC": "clang",
      "externalCommands": {
        "CLANG_TRIPLE": "aarch64-linux-gnu-",
        "CROSS_COMPILE": "aarch64-linux-android-",
        "CROSS_COMPILE_COMPAT": "arm-linux-androideabi-",
        "LD": "ld.lld",
        "AR": "llvm-ar",
        "NM": "llvm-nm",
        "OBJCOPY": "llvm-objcopy",
        "OBJDUMP": "llvm-objdump",
        "READELF": "llvm-readelf",
        "OBJSIZE": "llvm-size",
        "STRIP": "llvm-strip",
        "LLVM_AR": "llvm-ar",
        "LLVM_DIS": "llvm-dis",
        "CONFIG_THINLTO": ""
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "custom": {
        "repo": "https://github.com/Lafactorial/Anykernel31/",
        "branch": "sweetk6a"
      }
    },
    "enableKernelSU": true,
    "enableLXC": true
  }
]
