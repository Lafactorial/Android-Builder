[
  {
    "kernelSource": {
      "name": "Positron",
      "repo": "https://github.com/itsshashanksp/kernel_xiaomi_sm6150",
      "branch": "sleepy-k6a",
      "device": "sweet2",
      "defconfig": "vendor/sweet2.config sdmsteppe-perf_defconfig"
    },
    "enableCcache": true,
    "toolchains": [
      {
        "repo": "https://gitlab.com/itsshashanksp/android_prebuilts_clang_host_linux-x86_clang-r530567",
        "branch": "14.0",
        "name": "clang 19.0.1",
        "binaryEnv": [
          "bin"
        ]
      }
    ],
    "params": {
      "ARCH": "arm64",
      "CC": "="$HOME/clang/bin:$PATH",
      "externalCommands": {
        "CROSS_COMPILE": "clang 19.0.1/bin/aarch64-linux-gnu-",
        "CROSS_COMPILE_ARM32": "clang 19.0.1/bin/arm-linux-gnueabi-",
        "LD": "proton-clang/bin/ld.lld",
        "AR": "proton-clang/bin/llvm-ar",
        "NM": "proton-clang/bin/llvm-nm",
        "OBJCOPY": "proton-clang/bin/llvm-objcopy",
        "OBJDUMP": "proton-clang/bin/llvm-objdump",
        "READELF": "proton-clang/bin/llvm-readelf",
        "OBJSIZE": "proton-clang/bin/llvm-size",
        "STRIP": "proton-clang/bin/llvm-strip",
        "LDGOLD": "proton-clang/bin/aarch64-linux-gnu-ld.gold",
        "LLVM_AR": "proton-clang/bin/llvm-ar",
        "LLVM_DIS": "proton-clang/bin/llvm-dis"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "custom": {
        "repo": "https://github.com/itsshashanksp/AnyKernel3/",
        "branch": "sweetk6a"
      }
    "enableKernelSU": true,
    "enableLXC": false
  }
]
