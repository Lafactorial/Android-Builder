[
  {
    "kernelSource": {
      "name": "VantomKernel",
      "repo": "https://github.com/Lafactorial/kernel_xiaomi_sm6150",
      "branch": "fifteen",
      "device": "sweet_k6a",
      "defconfig": "sweet_defconfig"
    },
    "enableCcache": true,
    "toolchains": [
      {
        "repo": "https://gitlab.com/itsshashanksp/android_prebuilts_clang_host_linux-x86_clang-r530567",
        "branch": "14.0",
        "name": "clang",
        "binaryEnv": [
          "bin"
        ]
      }
    ],
    "params": {
      "ARCH": "arm64",
      "CC": "clang/bin/clang",
      "externalCommands": {
        "CLANG_TRIPLE": "clang/bin/aarch64-linux-gnu-",
        "CROSS_COMPILE": "clang/bin/aarch64-linux-android-",
        "CROSS_COMPILE_ARM32": "clang/bin/arm-linux-androideabi-",
        "LD": "clang/bin/ld.lld",
        "AR": "clang/bin/llvm-ar",
        "NM": "clang/bin/llvm-nm",
        "OBJCOPY": "clang/bin/llvm-objcopy",
        "OBJDUMP": "clang/bin/llvm-objdump",
        "READELF": "clang/bin/llvm-readelf",
        "OBJSIZE": "clang/bin/llvm-size",
        "STRIP": "clang/bin/llvm-strip",
        "LLVM_AR": "clang/bin/llvm-ar",
        "LLVM_DIS": "clang/bin/llvm-dis"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "custom": {
        "repo": "https://github.com/lafactorial/AnyKernel31/",
        "branch": "sweetk6a"
      }
    },
    "enableKernelSU": true,
    "enableLXC": false
  }
]
