[
  {
    "kernelSource": {
      "name": "VantomKernel",
      "repo": "https://github.com/Lafactorial/kernel_xiaomi_sm6150",
      "branch": "fifteen",
      "device": "sweet_k6a",
      "defconfig": "sweet_defconfig"
    },
    "enableCcache": true,
    "toolchains": [
      {
        "repo": "https://gitlab.com/itsshashanksp/android_prebuilts_clang_host_linux-x86_clang-r530567",
        "branch": "14.0",
        "name": "clang",
        "binaryEnv": [
          "bin"
        ]
      }
    ],
    "params": {
                              ARCH=arm64 \
                              LLVM=1 \
                              LLVM_IAS=1 \
                              AR=llvm-ar \
                              NM=llvm-nm \
                              LD=ld.lld \
                              OBJCOPY=llvm-objcopy \
                              OBJDUMP=llvm-objdump \
                              STRIP=llvm-strip \
                              CC=clang \
                              CLANG_TRIPLE=aarch64-linux-gnu- \
                              CROSS_COMPILE=aarch64-linux-android- \
                              CROSS_COMPILE_ARM32=arm-linux-androideabi-
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "custom": {
        "repo": "https://github.com/lafactorial/AnyKernel31/",
        "branch": "sweetk6a"
      }
    },
    "enableKernelSU": true,
    "enableLXC": false
  }
]
